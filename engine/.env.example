# VozAta engine configuration. Copy to `.env` (git-ignored) and adjust.
# Keys owned by roadmap phases 01-06, 12, 14 and 25-28; see docs/roadmap/architecture.md §9.

# --- Core (phase 01) ---
# Transcription window length in seconds (CHUNK_MODE=fixed).
CHUNK_SECONDS=5
# Internal audio sample rate in Hz.
SAMPLE_RATE=16000
# Application language: en | pt-BR | es.
APP_LANGUAGE=en
# Conversation language: en | pt | es | auto; empty = derived from APP_LANGUAGE.
TRANSCRIPTION_LANGUAGE=
# Override the localized label for the microphone track; empty = localized default.
MIC_LABEL=
# Override the localized label for the system-audio track; empty = localized default.
SYSTEM_LABEL=
# Root folder for recorded sessions.
OUTPUT_DIR=recordings

# --- Audio (phase 02) ---
# Mixed output file: mono | stereo (mic left, system right).
MIX_MODE=mono

# --- Transcription (phase 03) ---
# Words ending this close (seconds) to the window end are not committed yet.
TAIL_MARGIN_SECONDS=0.6
# Silence gap (seconds) that counts as a phrase boundary.
PAUSE_GAP_SECONDS=0.5
# Force a commit when carried-over audio exceeds this many seconds.
MAX_CARRY_SECONDS=15
# Windows with RMS below this level are skipped as silence.
SILENCE_RMS_THRESHOLD=0.01
# Speech-to-text provider registry key.
STT_PROVIDER=faster_whisper
# faster-whisper model used on the GPU.
WHISPER_MODEL=large-v3-turbo
# Inference device: auto | cuda | cpu.
WHISPER_DEVICE=auto
# CTranslate2 compute type on the GPU.
WHISPER_COMPUTE_TYPE=int8_float16
# Fallback model used on the CPU.
WHISPER_CPU_MODEL=small
# serve only: keep the speech model loaded between recordings so the next one transcribes at once
# (phase 26). It is still released before minutes are generated: true | false.
WHISPER_KEEP_LOADED=false

# --- External STT API (phase 12): STT_PROVIDER=openai_compatible ---
# Audio LEAVES THIS MACHINE and is sent to this provider. Any OpenAI-style
# /audio/transcriptions API with word timestamps works: OpenAI, Groq or a self-hosted server.
# Cost: a 1-hour meeting sends up to 2 hours of audio (two channels; silence is skipped).
# Indicative prices, check the provider's current pricing: OpenAI whisper-1 ~US$0.006/minute;
# Groq whisper-large-v3 ~US$0.11/hour, whisper-large-v3-turbo ~US$0.04/hour.
# Base URL: https://api.openai.com/v1 (OpenAI) or https://api.groq.com/openai/v1 (Groq).
OPENAI_STT_URL=https://api.openai.com/v1
# API key (secret: never logged, masked by the API and the settings page).
OPENAI_STT_KEY=
# Model: whisper-1 (OpenAI), whisper-large-v3 or whisper-large-v3-turbo (Groq).
OPENAI_STT_MODEL=whisper-1

# --- Speaker identification (phase 14) ---
# After a recording stops, tell the remote speakers in system.wav apart (User 1, User 2, ...): true | false.
# Setup: pip install -e ".[diarization]" in engine/, create a Hugging Face access token
# (https://huggingface.co/settings/tokens), accept the terms of the pyannote model
# pyannote/speaker-diarization-community-1 on its model page, then set HF_TOKEN below.
DIARIZATION_ENABLED=false
# Speaker identification provider registry key.
DIARIZATION_PROVIDER=pyannote
# Device for speaker identification: auto | cuda | cpu (runs after Whisper is released).
DIARIZATION_DEVICE=auto
# Hugging Face access token for the pyannote models (secret; never logged).
HF_TOKEN=
# Smallest number of remote speakers to expect (1-20); empty = detect.
MIN_SPEAKERS=
# Largest number of remote speakers to expect (1-20); empty = detect.
MAX_SPEAKERS=

# --- Pause-based segmentation (phase 27) ---
# How audio is cut for transcription: vad (at pauses) | fixed (CHUNK_SECONDS windows).
CHUNK_MODE=vad
# Silero speech probability above which audio counts as speech (0.01-0.99).
VAD_THRESHOLD=0.5
# A pause at least this long (ms) after speech ends a chunk.
VAD_MIN_SILENCE_MS=600
# Speech shorter than this (seconds) is not sent alone; it joins the next utterance.
VAD_MIN_CHUNK_SECONDS=1
# Longest chunk (seconds); longer speech is cut at its longest pause, or at this limit.
VAD_MAX_CHUNK_SECONDS=15
# Audio (ms) kept before the first word of a chunk.
VAD_SPEECH_PAD_MS=200

# --- Live interim text (phase 28) ---
# Show provisional text while someone is still speaking (the GPU only does it when idle): true | false.
LIVE_PARTIALS=true
# Minimum seconds between two interim updates of the same channel (0.5-10).
PARTIAL_INTERVAL_SECONDS=1.5

# --- Echo dedupe (phase 18) ---
# Drop microphone lines that repeat what the speakers played (no headphones): true | false.
ECHO_DEDUPE_ENABLED=true
# Share of a microphone line's words (0.5-1) found in the system audio at the same time to drop it.
ECHO_SIMILARITY=0.85
# Seconds a microphone line waits for the matching system line (1-60); empty = CHUNK_SECONDS + 3.
# Microphone lines appear this much later than system lines.
ECHO_HOLD_SECONDS=

# --- Minutes (phase 04) ---
# Language-model provider registry key.
LLM_PROVIDER=ollama
# Ollama server URL.
OLLAMA_URL=http://localhost:11434
# Ollama model; must fit in 6 GB of VRAM (Whisper is released before minutes are generated).
# Smaller alternative for tighter GPUs or faster minutes: qwen2.5:3b (~1.9 GB).
OLLAMA_MODEL=qwen2.5:7b
# Transcripts longer than this many characters are summarized with map-reduce.
LLM_MAX_CHARS=12000

# --- Minutes templates (phase 20) ---
# Default minutes template: general | daily | one_on_one | client | retrospective.
# The Start screen and "Regenerate minutes" can pick another one per session.
MINUTES_TEMPLATE=general

# --- LLM VRAM release (phase 25) ---
# How long Ollama keeps the model loaded after a minutes job: seconds (0 = unload at once,
# -1 = forever) or a duration such as 5m. Keep 0 on a 6 GB GPU so Whisper never shares VRAM with it.
OLLAMA_KEEP_ALIVE=0

# --- Session (phase 05) ---
# Generate minutes automatically when a recording stops: true | false.
GENERATE_MINUTES=true

# --- Engine API (phase 06) ---
# Address the local API listens on. Never use 0.0.0.0: the API has no authentication.
API_HOST=127.0.0.1
# Port of the local API.
API_PORT=8765
