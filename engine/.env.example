# VozAta engine configuration. Copy to `.env` (git-ignored) and adjust.
# Keys owned by roadmap phases 01-06, 12, 14, 23 and 25-28; see docs/roadmap/architecture.md §9.

# --- Core (phase 01) ---
# Transcription window length in seconds (CHUNK_MODE=fixed).
CHUNK_SECONDS=5
# Internal audio sample rate in Hz.
SAMPLE_RATE=16000
# Application language: en | pt-BR | es.
APP_LANGUAGE=en
# Conversation language: en | pt | es | auto; empty = derived from APP_LANGUAGE.
TRANSCRIPTION_LANGUAGE=
# Override the localized label for the microphone track; empty = localized default.
MIC_LABEL=
# Override the localized label for the system-audio track; empty = localized default.
SYSTEM_LABEL=
# Root folder for recorded sessions.
OUTPUT_DIR=recordings

# --- Storage (phase 31) ---
# Where sessions are stored: sqlite (one database, vozata.db, audio included) | files (one folder
# per session: JSON and Markdown files and the WAVs). Applies on restart.
STORAGE_BACKEND=sqlite
# The SQLite database file; empty = OUTPUT_DIR/vozata.db. Keep it out of OneDrive-synced folders
# (sync locks the file and can corrupt it): the engine warns at start. Applies on restart.
DATABASE_PATH=
# sqlite: WAV files built from the database when a tool needs a file (speaker identification)
# are kept in OUTPUT_DIR/cache, least recently used first out, up to this many MB (phase 32).
# Applies on restart.
AUDIO_CACHE_MB=2048

# --- Audio (phase 02) ---
# Mixed output file: mono | stereo (mic left, system right).
MIX_MODE=mono

# --- Meeting app detection (phase 54) ---
# Offer to record when one of these apps is in a call and nothing is recorded (never records
# by itself). Executable names, comma-separated.
MEETING_DETECTION=true
MEETING_APPS=ms-teams.exe, Teams.exe, Zoom.exe, CiscoCollabHost.exe, webex.exe, slack.exe, Discord.exe
MEETING_POLL_SECONDS=5

# --- Transcription (phase 03) ---
# Words ending this close (seconds) to the window end are not committed yet.
TAIL_MARGIN_SECONDS=0.6
# Silence gap (seconds) that counts as a phrase boundary.
PAUSE_GAP_SECONDS=0.5
# Force a commit when carried-over audio exceeds this many seconds.
MAX_CARRY_SECONDS=15
# Windows with RMS below this level are skipped as silence.
SILENCE_RMS_THRESHOLD=0.01
# Speech-to-text provider registry key.
STT_PROVIDER=faster_whisper
# faster-whisper model used on the GPU.
WHISPER_MODEL=large-v3-turbo
# Inference device: auto | cuda | cpu.
WHISPER_DEVICE=auto
# CTranslate2 compute type on the GPU.
WHISPER_COMPUTE_TYPE=int8_float16
# Fallback model used on the CPU.
WHISPER_CPU_MODEL=small
# serve only: keep the speech model loaded between recordings so the next one transcribes at once
# (phase 26). It is still released before minutes are generated: true | false.
WHISPER_KEEP_LOADED=false

# --- External STT API (phase 12): STT_PROVIDER=openai_compatible ---
# Audio LEAVES THIS MACHINE and is sent to this provider. Any OpenAI-style
# /audio/transcriptions API with word timestamps works: OpenAI, Groq or a self-hosted server.
# Cost: a 1-hour meeting sends up to 2 hours of audio (two channels; silence is skipped).
# Indicative prices, check the provider's current pricing: OpenAI whisper-1 ~US$0.006/minute;
# Groq whisper-large-v3 ~US$0.11/hour, whisper-large-v3-turbo ~US$0.04/hour.
# Base URL: https://api.openai.com/v1 (OpenAI) or https://api.groq.com/openai/v1 (Groq).
OPENAI_STT_URL=https://api.openai.com/v1
# API key (secret: never logged, masked by the API and the settings page).
OPENAI_STT_KEY=
# Model: whisper-1 (OpenAI), whisper-large-v3 or whisper-large-v3-turbo (Groq).
OPENAI_STT_MODEL=whisper-1

# --- Speaker identification (phase 14) ---
# After a recording stops, tell the remote speakers in system.wav apart (User 1, User 2, ...): true | false.
# Setup: pip install -e ".[diarization]" in engine/, create a Hugging Face access token
# (https://huggingface.co/settings/tokens), accept the terms of the pyannote model
# pyannote/speaker-diarization-community-1 on its model page, then set HF_TOKEN below.
DIARIZATION_ENABLED=false
# Speaker identification provider registry key: pyannote | vozata_worker (phase 45: on the
# VozAta worker at WORKER_URL, which needs HF_TOKEN there; this PC's pyannote when it is off).
DIARIZATION_PROVIDER=pyannote
# Device for speaker identification: auto | cuda | cpu (runs after Whisper is released).
DIARIZATION_DEVICE=auto
# Hugging Face access token for the pyannote models (secret; never logged).
HF_TOKEN=
# Smallest number of remote speakers to expect (1-20); empty = detect.
MIN_SPEAKERS=
# Largest number of remote speakers to expect (1-20); empty = detect.
MAX_SPEAKERS=

# --- Live speaker identification (phase 15) ---
# Show "User N" labels on system lines during the meeting (best effort; the post-session pass
# above corrects them at stop). Needs the diarization extra and HF_TOKEN, and keeps a small
# speaker-embedding model loaded in a child process while recording.
LIVE_DIARIZATION_ENABLED=false
# Cosine similarity (0.05-1) a line's voice needs to join an existing speaker; lower merges more
# voices into one speaker, higher splits one voice into several.
SPEAKER_SIMILARITY_THRESHOLD=0.7

# --- Pause-based segmentation (phase 27) ---
# How audio is cut for transcription: vad (at pauses) | fixed (CHUNK_SECONDS windows).
CHUNK_MODE=vad
# Silero speech probability above which audio counts as speech (0.01-0.99).
VAD_THRESHOLD=0.5
# A pause at least this long (ms) after speech ends a chunk.
VAD_MIN_SILENCE_MS=600
# Speech shorter than this (seconds) is not sent alone; it joins the next utterance.
VAD_MIN_CHUNK_SECONDS=1
# Longest chunk (seconds); longer speech is cut at its longest pause, or at this limit.
VAD_MAX_CHUNK_SECONDS=15
# Audio (ms) kept before the first word of a chunk.
VAD_SPEECH_PAD_MS=200

# --- Live transcription (phase 41) ---
# Default of the per-recording option. false: new recordings only record audio and are transcribed
# after you stop (the background queue): true | false.
LIVE_TRANSCRIPTION=true

# --- Live interim text (phase 28) ---
# Show provisional text while someone is still speaking (the GPU only does it when idle): true | false.
LIVE_PARTIALS=true
# Minimum seconds between two interim updates of the same channel (0.5-10).
PARTIAL_INTERVAL_SECONDS=1.5

# --- Echo dedupe (phase 18) ---
# Drop microphone lines that repeat what the speakers played (no headphones): true | false.
ECHO_DEDUPE_ENABLED=true
# Share of a microphone line's words (0.5-1) found in the system audio at the same time to drop it.
ECHO_SIMILARITY=0.85
# Seconds a microphone line waits for the matching system line (1-60); empty = CHUNK_SECONDS + 3.
# Microphone lines appear this much later than system lines.
ECHO_HOLD_SECONDS=

# --- Custom vocabulary (phase 19) ---
# Glossary file: one term per line (names, acronyms, product terms), # starts a comment.
# Empty = vocabulary.txt next to this .env. Edited from the settings tab "Vocabulary".
VOCABULARY_FILE=
# Characters of each channel's recent text given to the speech model as context (0-1000, 0 = off).
CONTEXT_PROMPT_CHARS=200

# --- Editable transcript (phase 21) ---
# Words recognized with a probability below this (0-1) are highlighted in the transcript viewer.
LOW_CONFIDENCE_THRESHOLD=0.5

# --- Live translation (phase 29) ---
# Translate each committed segment while recording: off | en | pt | es (empty = off).
# The Start screen can pick another language per session. Runs on CPU (Whisper keeps the GPU).
TRANSLATE_TO=off
# Translation provider registry key. opus_mt = Opus-MT models on CTranslate2; needs the optional
# extra: python -m pip install -e ".[translation]" (in engine/). vozata_worker = opus-mt on the
# VozAta worker at WORKER_URL (phase 46), this PC's when it does not answer.
TRANSLATION_PROVIDER=opus_mt
# Folder with the converted models (opus-mt-ROMANCE-en/, opus-mt-en-ROMANCE/). Empty = download
# them once (~155 MB each) into the Hugging Face cache on first use.
TRANSLATION_MODEL_DIR=

# --- Minutes (phase 04) ---
# Language-model provider registry key.
LLM_PROVIDER=ollama
# Ollama server URL.
OLLAMA_URL=http://localhost:11434
# Ollama model; must fit in 6 GB of VRAM (Whisper is released before minutes are generated).
# Smaller alternative for tighter GPUs or faster minutes: qwen2.5:3b (~1.9 GB).
OLLAMA_MODEL=qwen2.5:7b
# Transcripts longer than this many characters are summarized with map-reduce.
LLM_MAX_CHARS=12000

# --- Other language models (phase 53): LLM_PROVIDER=openai_compatible or anthropic ---
# An OpenAI-compatible chat server: LM Studio (default address), vLLM, the llama.cpp server,
# Ollama's http://localhost:11434/v1, or https://api.openai.com/v1.
OPENAI_LLM_URL=http://localhost:1234/v1
# Only when the server asks for a key (OpenAI does).
OPENAI_LLM_KEY=
# Empty: the first model the server lists (the one loaded in LM Studio).
OPENAI_LLM_MODEL=
# Claude (Anthropic): the transcripts are sent to api.anthropic.com; usage is billed by Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Minutes templates (phase 20) ---
# Default minutes template: general | daily | one_on_one | client | retrospective.
# The Start screen and "Regenerate minutes" can pick another one per session.
MINUTES_TEMPLATE=general

# --- LLM VRAM release (phase 25) ---
# How long Ollama keeps the model loaded after a minutes job: seconds (0 = unload at once,
# -1 = forever) or a duration such as 5m. Keep 0 on a 6 GB GPU so Whisper never shares VRAM with it.
OLLAMA_KEEP_ALIVE=0

# --- Action items export (phase 23) ---
# Extract action items (description, owner, due date) after the minutes: true | false.
# Runs only when GENERATE_MINUTES=true; the session's Action items tab can extract them again.
EXTRACT_ACTION_ITEMS=true
# Azure DevOps export: organization URL (https://dev.azure.com/<org>), project name and a
# personal access token with the "Work Items (Read & write)" scope. All three empty = not offered.
AZDO_ORG_URL=
AZDO_PROJECT=
# Azure DevOps personal access token (secret: never logged, masked by the API and the settings page).
AZDO_PAT=
# GitHub Issues export: repository as owner/name and a token allowed to create issues
# (fine-grained: "Issues: Read and write"). Both empty = not offered.
GITHUB_REPO=
# GitHub token (secret: never logged, masked by the API and the settings page).
GITHUB_TOKEN=

# --- Session (phase 05) ---
# Generate minutes automatically when a recording stops: true | false.
GENERATE_MINUTES=true

# --- Crash recovery (phase 17) ---
# Seconds between two saves of session.json while recording (1-300); a crashed session is found
# and recovered on the next start.
AUTOSAVE_SECONDS=10

# --- Worker on another PC (phase 44) ---
# On this PC: the VozAta worker of a GPU PC of the local network, e.g. http://192.168.0.50:8766
# (empty: no worker), and its token (secret: never logged, masked by the API and the settings page).
WORKER_URL=
WORKER_TOKEN=
# On the worker PC: where `vozata worker` listens. A host other than 127.0.0.1 / localhost always
# needs WORKER_TOKEN (the first start makes one and saves it here).
WORKER_HOST=0.0.0.0
WORKER_PORT=8766
# Phase 47. On this PC: the id of the paired worker (set by pairing; lets VozAta find it again
# when its address changes). On the worker PC: its own id (made on the first start), the name
# shown when VozAta looks for workers (empty: the PC name), and the UDP port it answers on.
WORKER_ID=
WORKER_NAME=
WORKER_DISCOVERY_PORT=8767

# --- Voice commands (phase 50) ---
# While recording, "<wake word>, <phrase>" said into the microphone runs a command: minutes so
# far, or a question about the meeting so far. The phrases live in VOICE_COMMANDS_FILE (empty:
# voice_commands.json next to this file; without it, the defaults of APP_LANGUAGE).
VOICE_COMMANDS_ENABLED=true
WAKE_WORD=VozAta
VOICE_COMMANDS_FILE=

# --- Engine API (phase 06) ---
# Address the local API listens on. Never use 0.0.0.0: the API has no authentication.
API_HOST=127.0.0.1
# Port of the local API.
API_PORT=8765
