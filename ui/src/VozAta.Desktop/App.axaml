<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VozAta.Desktop.App"
             RequestedThemeVariant="Default">
             <!-- "Default" follows the system theme; the saved preference (ui.json "theme") replaces it at start-up. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://VozAta.Desktop/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://VozAta.Desktop/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <!-- Fluent controls (selection, toggles, focus) follow the accent token Brush.Accent -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#E57CD8" />
                <ColorPaletteResources x:Key="Dark" Accent="#E57CD8" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://VozAta.Desktop/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
