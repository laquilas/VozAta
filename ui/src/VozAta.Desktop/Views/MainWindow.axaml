<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VozAta.Desktop.ViewModels"
        xmlns:views="using:VozAta.Desktop.Views"
        xmlns:client="using:VozAta.Client"
        x:Class="VozAta.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding L[AppTitle]}"
        Icon="/Assets/vozata.ico"
        Width="{Binding WindowWidth, Mode=TwoWay}" Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="640" MinHeight="420">

  <DockPanel>
    <!-- Status bar: engine, GPU, speech model, minutes model -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <WrapPanel>
        <Image Source="/Assets/vozata-64.png" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
               ToolTip.Tip="{Binding L[AppTitle]}" />
        <TextBlock Text="{Binding EngineText}" Margin="0,0,24,0" />
        <TextBlock Text="{Binding Health.GpuText}" Margin="0,0,24,0" />
        <TextBlock Text="{Binding Health.SpeechText}" Margin="0,0,24,0" />
        <TextBlock Text="{Binding Health.MinutesText}" />
      </WrapPanel>
    </Border>

    <!-- Notifications (engine errors, minutes ready) -->
    <ItemsControl DockPanel.Dock="Top" Margin="16,0" ItemsSource="{Binding Notifications}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Border Margin="0,4" Classes="banner warning">
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="12,0,0,0"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Dismiss]}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DismissNotificationCommand}"
                      CommandParameter="{Binding}" />
              <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Crash recovery dialog (phase 17): interrupted sessions with Recover / Later -->
    <Border DockPanel.Dock="Top" Margin="16,4" Padding="16,12" Classes="banner info"
            IsVisible="{Binding Recovery.IsOpen}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding L[RecoveryTitle]}" Classes="subtitle" />
        <TextBlock Text="{Binding L[RecoveryMessage]}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Recovery.Sessions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecoverySession">
              <Grid ColumnDefinitions="Auto,Auto" Margin="0,2">
                <TextBlock Text="{Binding Started}" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Grid.Column="1" Text="{Binding Duration}" Classes="secondary tabular" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="{Binding L[RecoveryLater]}" Command="{Binding Recovery.LaterCommand}" />
          <Button Classes="primary" Content="{Binding L[RecoveryRecover]}"
                  Command="{Binding Recovery.RecoverCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl Margin="0,4,0,0">
      <TabItem Header="{Binding L[TabRecording]}">
        <DockPanel>
          <!-- Controls: Start/Stop, state, elapsed time, languages -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,16,16,8">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <Button Classes="primary large"
                      Command="{Binding Recorder.StartCommand}"
                      IsVisible="{Binding !Recorder.IsRecording}"
                      Content="{Binding L[Start]}" />
              <Button Classes="danger large"
                      AutomationProperties.Name="{Binding L[Stop]}"
                      Command="{Binding Recorder.StopCommand}"
                      IsVisible="{Binding Recorder.IsRecording}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Classes="inline" Data="{StaticResource Icon.Stop}" />
                  <TextBlock Text="{Binding L[Stop]}" />
                </StackPanel>
              </Button>
              <Button Classes="large" Padding="22,14" Command="{Binding Recorder.PauseResumeCommand}"
                      IsVisible="{Binding Recorder.IsRecording}" Content="{Binding Recorder.PauseResumeText}" />
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="state-dot recording"
                           IsVisible="{Binding Recorder.IsActivelyRecording}" />
                  <Ellipse Classes="state-dot paused"
                           IsVisible="{Binding Recorder.IsPaused}" />
                  <TextBlock Text="{Binding Recorder.StatusText}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{Binding Recorder.Elapsed}" Classes="timer" />
                <TextBlock Text="{Binding L[ModelLoading]}" Classes="hint warning"
                           IsVisible="{Binding Recorder.IsModelLoading}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4" MinWidth="230">
              <TextBlock Text="{Binding L[ConversationLanguage]}" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Recorder.ConversationLanguages}"
                        SelectedItem="{Binding Recorder.SelectedLanguage}"
                        IsEnabled="{Binding !Recorder.IsRecording}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding Recorder.DetectedLanguage}" FontStyle="Italic"
                         IsVisible="{Binding Recorder.DetectedLanguage, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <!-- Live translation (phase 29) -->
              <TextBlock Text="{Binding L[TranslateTo]}" Margin="0,6,0,0" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Recorder.TranslationLanguages}"
                        SelectedItem="{Binding Recorder.SelectedTranslation}"
                        IsEnabled="{Binding !Recorder.IsRecording}"
                        AutomationProperties.Name="{Binding L[TranslateTo]}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding L[MinutesTemplate]}" Margin="0,6,0,0" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Recorder.Templates.Items}"
                        SelectedItem="{Binding Recorder.SelectedTemplate}"
                        IsEnabled="{Binding !Recorder.IsRecording}"
                        AutomationProperties.Name="{Binding L[MinutesTemplate]}"
                        DisplayMemberBinding="{Binding Name, x:DataType=vm:TemplateOption}" />
              <TextBlock Text="{Binding L[InterfaceLanguage]}" Margin="0,6,0,0" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AppLanguages}"
                        SelectedItem="{Binding SelectedAppLanguage}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>

          <!-- Terms for this meeting (phase 19): sent with Start, merged with the glossary -->
          <Expander DockPanel.Dock="Top" Margin="16,0,16,8" HorizontalAlignment="Stretch"
                    Header="{Binding L[SessionTerms]}" IsEnabled="{Binding !Recorder.IsRecording}">
            <TextBox Text="{Binding Recorder.SessionTerms}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"
                     PlaceholderText="{Binding L[SessionTermsHint]}"
                     AutomationProperties.Name="{Binding L[SessionTerms]}" />
          </Expander>

          <!-- Devices (locked while recording) and level meters -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,24,*" Margin="16,0,16,8">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" x:DataType="vm:DevicesViewModel"
                  DataContext="{Binding Recorder.Devices}" IsEnabled="{Binding IsEnabled}">
              <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Microphone]}"
                         VerticalAlignment="Center" Margin="0,0,8,4" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                        ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedMic}"
                        DisplayMemberBinding="{Binding Name, x:DataType=client:AudioDevice}" />
              <Button Grid.Column="2" Grid.RowSpan="2" Margin="8,0,0,0" Classes="icon"
                      Command="{Binding RefreshCommand}"
                      ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[RefreshDevices]}"
                      AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[RefreshDevices]}">
                <PathIcon Data="{StaticResource Icon.Refresh}" />
              </Button>
              <TextBlock Grid.Row="1" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[SystemOutput]}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Loopbacks}" SelectedItem="{Binding SelectedLoopback}"
                        DisplayMemberBinding="{Binding Name, x:DataType=client:AudioDevice}" />
            </Grid>
            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
              <Grid ColumnDefinitions="90,*" x:DataType="vm:LevelMeterViewModel" DataContext="{Binding Recorder.MicMeter}">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <Panel Grid.Column="1" Height="12">
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding Peak}" Classes="meter-mic-peak" />
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding Level}" Classes="meter-mic" />
                </Panel>
              </Grid>
              <Grid ColumnDefinitions="90,*" x:DataType="vm:LevelMeterViewModel" DataContext="{Binding Recorder.SystemMeter}">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <Panel Grid.Column="1" Height="12">
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding Peak}" Classes="meter-system-peak" />
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding Level}" Classes="meter-system" />
                </Panel>
              </Grid>
              <TextBlock Text="{Binding L[NoSystemSignal]}" Classes="warning" TextWrapping="Wrap"
                         IsVisible="{Binding Recorder.SystemMeter.NoSignal}" />
            </StackPanel>
          </Grid>

          <!-- Live transcript -->
          <Border Margin="16,8,16,16" Classes="outline">
            <Panel>
              <TextBlock Text="{Binding L[TranscriptEmpty]}" Classes="secondary" Margin="16"
                         TextWrapping="Wrap" IsVisible="{Binding Recorder.IsTranscriptEmpty}" />
              <ScrollViewer views:AutoScroll.IsEnabled="True">
                <StackPanel Margin="12">
                  <ItemsControl ItemsSource="{Binding Recorder.Segments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TranscriptLine">
                        <StackPanel Margin="0,3">
                          <SelectableTextBlock Text="{Binding Display}" Classes="channel reading"
                                               Classes.mic="{Binding IsMic}" Classes.system="{Binding IsSystem}"
                                               TextWrapping="Wrap" />
                          <!-- Live translation (phase 29): smaller and muted, under its line -->
                          <SelectableTextBlock Text="{Binding Translation}" Classes="translation"
                                               TextWrapping="Wrap" Margin="16,1,0,0"
                                               IsVisible="{Binding HasTranslation}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Interim text (phase 28): grey italic, replaced in place, removed by the segment -->
                  <ItemsControl ItemsSource="{Binding Recorder.Partials}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TranscriptLine">
                        <TextBlock Text="{Binding Display}" Classes="partial"
                                   TextWrapping="Wrap" Margin="0,3" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </Border>
        </DockPanel>
      </TabItem>
      <TabItem Header="{Binding L[TabHistory]}">
        <views:HistoryView DataContext="{Binding History}" />
      </TabItem>
      <TabItem Header="{Binding L[TabSettings]}">
        <views:SettingsView DataContext="{Binding Settings}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
