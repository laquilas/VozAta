<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VozAta.Desktop.ViewModels"
        xmlns:views="using:VozAta.Desktop.Views"
        x:Class="VozAta.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding L[AppTitle]}"
        Icon="/Assets/vozata.ico"
        Width="{Binding WindowWidth, Mode=TwoWay}" Height="{Binding WindowHeight, Mode=TwoWay}"
        MinWidth="720" MinHeight="460">

  <!-- Ctrl+1…4 switch pages (phase 35), in sidebar order -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding Shell.NavigateCommand}" CommandParameter="recorder" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding Shell.NavigateCommand}" CommandParameter="meetings" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding Shell.NavigateCommand}" CommandParameter="ask" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding Shell.NavigateCommand}" CommandParameter="config" />
  </Window.KeyBindings>

  <views:ShellView />
</Window>
