<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VozAta.Desktop.ViewModels"
             x:Class="VozAta.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <DockPanel Margin="16,8,16,16">
    <!-- Save / discard / restart -->
    <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Command="{Binding SaveCommand}"
                  Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[SettingsSave]}" />
          <Button Command="{Binding DiscardCommand}"
                  Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[SettingsDiscard]}" />
          <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="#2E7D32" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding Error}" VerticalAlignment="Center" Foreground="#C62828" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <Border Padding="12,8" CornerRadius="4" Background="#FFF3E0" BorderBrush="#FB8C00" BorderThickness="1"
                IsVisible="{Binding !!RestartKeys.Count}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                    Command="{Binding RestartEngineCommand}"
                    Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[RestartEngine]}" />
            <StackPanel>
              <TextBlock Foreground="#4E342E"
                         Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[SettingsRestartRequired]}" />
              <ItemsControl ItemsSource="{Binding RestartKeys}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="#4E342E" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Spacing="16" Margin="0,0,12,0">
        <!-- Engine status -->
        <Border Padding="12" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext).Health}"
                x:DataType="vm:HealthViewModel">
          <DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding CheckAgainCommand}"
                    Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[CheckAgain]}" />
            <StackPanel Spacing="2">
              <TextBlock FontSize="16" FontWeight="SemiBold"
                         Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[HealthTitle]}" />
              <TextBlock Text="{Binding GpuText}" />
              <TextBlock Text="{Binding SpeechText}" />
              <TextBlock Text="{Binding MinutesText}" />
              <TextBlock Text="{Binding Error}" Foreground="#C62828"
                         IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Desktop app preferences (stored by the app, not in the engine .env) -->
        <Border Padding="12" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock FontSize="16" FontWeight="SemiBold"
                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[DesktopPreferences]}" />
            <CheckBox IsChecked="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tray.MinimizeToTray}"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[MinimizeToTray]}" />
          </StackPanel>
        </Border>

        <!-- Vocabulary (phase 19): the glossary file, saved on every change -->
        <Border Padding="12" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext).Vocabulary}"
                x:DataType="vm:VocabularyViewModel">
          <StackPanel Spacing="8">
            <TextBlock FontSize="16" FontWeight="SemiBold"
                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyTitle]}" />
            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyHelp]}" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding AddCommand}"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyAdd]}" />
              <TextBox Text="{Binding NewTerm}"
                       PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyNewTerm]}"
                       AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyNewTerm]}" />
            </DockPanel>
            <TextBlock Opacity="0.6" IsVisible="{Binding IsEmpty}"
                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyEmpty]}" />
            <ItemsControl ItemsSource="{Binding Terms}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Margin="0,0,6,6" Padding="10,2,2,2" CornerRadius="12"
                          Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                      <Button Content="✕" Padding="6,0" Background="Transparent"
                              Command="{Binding $parent[ItemsControl].((vm:VocabularyViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyRemove]}"
                              AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyRemove]}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top" Command="{Binding ImportCommand}"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyImport]}" />
              <TextBox Text="{Binding ImportText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                       PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyImportHint]}"
                       AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[VocabularyImport]}" />
            </DockPanel>
            <TextBlock Text="{Binding Message}" Foreground="#2E7D32" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

        <!-- One card per group, one editor per key -->
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingGroupViewModel">
              <StackPanel Spacing="10" Margin="0,0,0,18">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Editors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingEditorViewModel">
                      <Grid ColumnDefinitions="260,*" Margin="0,0,0,12">
                        <StackPanel Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[SettingsNeedsRestart]}"
                                     FontSize="11" Foreground="#E65100" IsVisible="{Binding NeedsRestart}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBox Text="{Binding TextValue}" IsVisible="{Binding IsText}"
                                   AutomationProperties.Name="{Binding Label}" />
                          <TextBox Text="{Binding TextValue}" PasswordChar="•" IsVisible="{Binding IsSecret}"
                                   AutomationProperties.Name="{Binding Label}" />
                          <NumericUpDown Value="{Binding NumberValue}" FormatString="{Binding NumberFormat}"
                                         IsVisible="{Binding IsNumeric}" HorizontalAlignment="Left" MinWidth="180"
                                         AutomationProperties.Name="{Binding Label}" />
                          <ToggleSwitch IsChecked="{Binding BoolValue}" IsVisible="{Binding IsToggle}"
                                        AutomationProperties.Name="{Binding Label}" />
                          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                                    IsVisible="{Binding IsChoice}" MinWidth="220"
                                    AutomationProperties.Name="{Binding Label}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:SettingChoice">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Text="{Binding Help}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap"
                                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
