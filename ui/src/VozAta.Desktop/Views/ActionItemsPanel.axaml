<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VozAta.Desktop.ViewModels"
             x:Class="VozAta.Desktop.Views.ActionItemsPanel"
             x:DataType="vm:ActionItemsViewModel">
  <!-- Action items (phase 23): checklist, export target, created links; exported items are read-only -->
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding ExtractCommand}"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsExtract]}" />
        <TextBlock VerticalAlignment="Center" Classes="hint"
                   Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsExtracting]}"
                   IsVisible="{Binding IsExtracting}" />
      </StackPanel>
      <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsEmpty]}"
                 Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
      <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding Message}" Classes="success" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HasItems}">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTargets}">
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsTarget]}" />
        <ComboBox MinWidth="160" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                  AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsTarget]}" />
        <Button Command="{Binding ExportCommand}"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsExport]}" />
      </StackPanel>
      <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsNoTargets]}"
                 Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding !HasTargets}" />
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ActionItemRow">
            <Border Classes="divider" Padding="0,6">
              <DockPanel>
                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,4,8,0"
                          IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEditable}"
                          AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsSelect]}" />
                <StackPanel Spacing="4">
                  <TextBox Text="{Binding Description}" IsEnabled="{Binding IsEditable}" TextWrapping="Wrap"
                           MaxLength="1000"
                           PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsDescription]}"
                           AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsDescription]}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Width="200" Text="{Binding Owner}" IsEnabled="{Binding IsEditable}" MaxLength="200"
                             PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsOwner]}"
                             AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsOwner]}" />
                    <TextBox Width="140" Text="{Binding Due}" IsEnabled="{Binding IsEditable}" MaxLength="100"
                             PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsDue]}"
                             AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsDue]}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsExported}">
                    <TextBlock VerticalAlignment="Center" Classes="secondary"
                               Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ActionItemsExportedLink]}" />
                    <Button Padding="4,1" Classes="link" Content="{Binding ExportedUrl}"
                            Command="{Binding $parent[UserControl].((vm:ActionItemsViewModel)DataContext).OpenLinkCommand}"
                            CommandParameter="{Binding ExportedUrl}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"
                             IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
