<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VozAta.Desktop.ViewModels"
             xmlns:views="using:VozAta.Desktop.Views"
             x:Class="VozAta.Desktop.Views.SessionDetailView"
             x:DataType="vm:SessionDetailViewModel">

  <!-- One meeting: minutes, transcript, speakers, action items (the Meetings page detail until phase 37) -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" Classes="title" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Date}" Classes="secondary" IsVisible="{Binding ShowsDate}" />
      <WrapPanel>
        <ComboBox Margin="0,0,4,4" MinWidth="170"
                  ItemsSource="{Binding Templates}" SelectedItem="{Binding RegenerateTemplate}"
                  IsVisible="{Binding !IsLive}"
                  PlaceholderText="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[MinutesTemplate]}"
                  AutomationProperties.Name="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[MinutesTemplate]}"
                  DisplayMemberBinding="{Binding Name, x:DataType=vm:TemplateOption}" />
        <Button Margin="0,0,8,4" Command="{Binding RegenerateMinutesCommand}"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[RegenerateMinutes]}"
                IsVisible="{Binding !IsLive}" />
        <Button Margin="0,0,8,4" Command="{Binding OpenAudioCommand}" CommandParameter="mixed"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[PlayMixed]}" />
        <Button Margin="0,0,8,4" Command="{Binding OpenAudioCommand}" CommandParameter="mic"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[PlayMic]}" />
        <Button Margin="0,0,8,4" Command="{Binding OpenAudioCommand}" CommandParameter="system"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[PlaySystem]}" />
        <Button Margin="0,0,8,4" Command="{Binding OpenFolderCommand}"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[OpenFolder]}"
                IsVisible="{Binding Folder, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Margin="0,0,8,4" Command="{Binding ExportCommand}" CommandParameter="md"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ExportMarkdown]}" />
        <Button Margin="0,0,8,4" Command="{Binding ExportCommand}" CommandParameter="docx"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ExportWord]}" />
        <Button Margin="0,0,8,4" Command="{Binding ExportCommand}" CommandParameter="pdf"
                Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[ExportPdf]}" />
      </WrapPanel>
      <TextBlock Text="{Binding Message}" Classes="success" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Regenerating]}"
                 Classes="hint warning" IsVisible="{Binding IsBusy}" />
      <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[Loading]}"
                 Classes="secondary" IsVisible="{Binding IsLoading}" />
      <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <TabControl SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TabMinutes]}">
        <Panel>
          <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[NoMinutes]}"
                     Classes="secondary" Margin="8" TextWrapping="Wrap"
                     IsVisible="{Binding !HasMinutes}" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Blocks}" Margin="8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MarkdownBlock">
                  <SelectableTextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,2"
                                       Classes.h1="{Binding IsHeading1}" Classes.h2="{Binding IsHeading2}"
                                       Classes.h3="{Binding IsHeading3}" Classes.item="{Binding IsItem}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </TabItem>
      <TabItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TabTranscript]}">
        <DockPanel>
          <!-- Edit mode toolbar (phase 21) -->
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="8,8,8,0" IsVisible="{Binding !IsLive}">
            <WrapPanel>
              <Button Margin="0,0,8,4" Command="{Binding Editor.EditCommand}"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TranscriptEdit]}"
                      IsVisible="{Binding !Editor.IsEditing}" />
              <Button Margin="0,0,8,4" Classes="primary" Command="{Binding Editor.SaveCommand}"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TranscriptSave]}"
                      IsVisible="{Binding Editor.IsEditing}" />
              <Button Margin="0,0,8,4" Command="{Binding Editor.CancelEditCommand}"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TranscriptCancelEdit]}"
                      IsVisible="{Binding Editor.IsEditing}" />
              <Button Margin="0,0,8,4" Command="{Binding Editor.RevertCommand}"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TranscriptRevert]}"
                      IsVisible="{Binding Editor.HasEdits}" />
            </WrapPanel>
            <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TranscriptSaving]}"
                       Classes="hint" IsVisible="{Binding Editor.IsSaving}" />
            <TextBlock Text="{Binding Editor.Error}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding Editor.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Editor.SuggestRegenerate}">
              <TextBlock VerticalAlignment="Center" Classes="success" TextWrapping="Wrap"
                         Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TranscriptSaved]}" />
              <Button Command="{Binding RegenerateMinutesCommand}"
                      Content="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[RegenerateMinutes]}" />
            </StackPanel>
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TranscriptHasEdits]}"
                       IsVisible="{Binding Editor.HasEdits}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TranscriptLowConfidenceHint]}"
                       IsVisible="{Binding HasLowConfidence}" />
          </StackPanel>
          <Panel>
            <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[NoTranscript]}"
                       Classes="secondary" Margin="8" IsVisible="{Binding !Lines.Count}" />
            <ScrollViewer IsVisible="{Binding !Editor.IsEditing}">
              <ItemsControl ItemsSource="{Binding Lines}" Margin="8"
                            views:ScrollToItem.Item="{Binding FocusedLine}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TranscriptLine">
                    <SelectableTextBlock views:ConfidenceText.Parts="{Binding DisplayParts}" Classes="channel reading"
                                         Classes.mic="{Binding IsMic}" Classes.system="{Binding IsSystem}"
                                         TextWrapping="Wrap" Margin="0,3"
                                         Classes.focused="{Binding IsFocused}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- Edit mode: one text box per segment -->
            <ScrollViewer IsVisible="{Binding Editor.IsEditing}">
              <ItemsControl ItemsSource="{Binding Editor.Segments}" Margin="8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EditableSegment">
                    <StackPanel Margin="0,3" Spacing="2">
                      <TextBlock Text="{Binding Header}" Classes="channel small"
                                 Classes.mic="{Binding IsMic}" Classes.system="{Binding IsSystem}" />
                      <TextBox Text="{Binding Text}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Reading}"
                               AutomationProperties.Name="{Binding Header}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </TabItem>
      <!-- Speaker rename (phase 16) -->
      <TabItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TabSpeakers]}"
               IsVisible="{Binding !IsLive}">
        <views:SpeakersPanel DataContext="{Binding Speakers}" />
      </TabItem>
      <!-- Action items export (phase 23) -->
      <TabItem Header="{Binding $parent[Window].((vm:MainViewModel)DataContext).L[TabActionItems]}"
               IsVisible="{Binding !IsLive}">
        <views:ActionItemsPanel DataContext="{Binding ActionItems}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
