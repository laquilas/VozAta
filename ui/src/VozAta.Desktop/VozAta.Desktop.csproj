<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe, taskbar and shortcut icon; single source in the repo's assets/ folder -->
    <ApplicationIcon>..\..\..\assets\desktop\windows\vozata.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VozAta.Client\VozAta.Client.csproj" />
  </ItemGroup>

  <!-- The theme gallery (phase 34) is a design review tool: debug builds only -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <AvaloniaXaml Remove="Diagnostics\**" />
    <Compile Remove="Diagnostics\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VozAta.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The VozAta logo, linked from the repo's assets/ folder (no copies to keep in sync) -->
    <AvaloniaResource Include="..\..\..\assets\desktop\windows\vozata.ico" Link="Assets\vozata.ico" />
    <AvaloniaResource Include="..\..\..\assets\desktop\windows\vozata-64.png" Link="Assets\vozata-64.png" />
  </ItemGroup>
</Project>
